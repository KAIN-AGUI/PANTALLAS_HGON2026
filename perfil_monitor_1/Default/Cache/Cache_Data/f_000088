    <script>
        function updateClock() {
            const now = new Date();
            const clockElement = document.getElementById('clock');
            if (clockElement) {
                clockElement.textContent = now.getHours().toString().padStart(2, '0') + ":" + now.getMinutes().toString().padStart(2, '0');
            }
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Actualización silenciosa en segundo plano
        async function updateData() {
            try {
                const response = await fetch(window.location.href);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const text = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');

                // Actualizar tabla principal
                const tableContainer = document.querySelector('.animate-table-scroll');
                const newTable = doc.querySelector('.animate-table-scroll');
                if (tableContainer && newTable) {
                    tableContainer.innerHTML = newTable.innerHTML;
                }

                // Actualizar resumen lateral
                const summaryContainer = document.querySelector('.animate-summary-scroll');
                const newSummary = doc.querySelector('.animate-summary-scroll');
                if (summaryContainer && newSummary) {
                    summaryContainer.innerHTML = newSummary.innerHTML;
                }

                // Actualizar total y porcentaje (opcional, pero recomendado)
                const mainLayout = doc.querySelector('main');
                if (mainLayout) {
                    const aside = document.querySelector('aside');
                    const newAside = mainLayout.querySelector('aside');
                    if (aside && newAside) {
                        aside.innerHTML = newAside.innerHTML;
                    }
                }

            } catch (e) {
                console.warn("Reintentando actualización de datos en Internados: ", e);
            }
        }
        setInterval(updateData, 60000); // 1 minuto para internados (menos frecuencia necesaria)
    </script>
