    <script>
        let currentMonitorIndex = 0;
        let rotationInterval;

        function rotateMonitor() {
            const cards = document.querySelectorAll('.monitor-card');
            if (cards.length === 0) return;

            // Asegurar que el índice esté en rango
            if (currentMonitorIndex >= cards.length) {
                currentMonitorIndex = 0;
            }

            cards.forEach((card, index) => {
                if (index === currentMonitorIndex) {
                    card.classList.add('active');
                } else {
                    card.classList.remove('active');
                }
            });

            currentMonitorIndex = (currentMonitorIndex + 1) % cards.length;
        }

        function startRotation() {
            if (rotationInterval) clearInterval(rotationInterval);
            rotateMonitor();
            rotationInterval = setInterval(rotateMonitor, 10000);
        }

        // Clock update
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const clockElement = document.getElementById('clock');
            if (clockElement) {
                clockElement.textContent = `${hours}:${minutes}`;
            }
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Background update without interrupting CSS animation
        const updateData = async () => {
            try {
                const response = await fetch(window.location.href);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const text = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');

                // Actualizar tabla principal
                const tableId = 'main-table-scroll';
                const newTable = doc.getElementById(tableId);
                const currentTable = document.getElementById(tableId);
                if (currentTable && newTable) {
                    currentTable.innerHTML = newTable.innerHTML;
                }

                // Actualizar contenedor de monitores (sidebar)
                const summaryId = 'monitor-container';
                const newSummary = doc.getElementById(summaryId);
                const currentSummary = document.getElementById(summaryId);

                if (currentSummary && newSummary) {
                    // Guardamos el índice actual antes de reemplazar el HTML
                    const oldIndex = (currentMonitorIndex > 0) ? currentMonitorIndex - 1 : 0;

                    currentSummary.innerHTML = newSummary.innerHTML;

                    // Restauramos el índice y reiniciamos rotación si cambió el número de cartas
                    const newCards = currentSummary.querySelectorAll('.monitor-card');
                    if (oldIndex < newCards.length) {
                        currentMonitorIndex = oldIndex;
                    } else {
                        currentMonitorIndex = 0;
                    }
                    startRotation();
                }
            } catch (e) {
                console.warn("Error silente en actualización de datos: ", e);
            }
        };

        setInterval(updateData, 30000);
        startRotation();

        // El reproductor de YouTube no requiere scripts complejos para la rotación básica
    </script>
